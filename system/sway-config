# =========================================================
# Apokolips OS — sway configuration
# =========================================================

set $mod Mod4

# Solid black under everything (shell draws the wallpaper)
output * bg #000000 solid_color

default_border none
default_floating_border normal 2
gaps inner 0
gaps outer 0

font pango:DejaVu Sans 10

# Launch the shell
exec_always sh -c 'while true; do /home/lytone/apokolips-shell/run-session.sh; sleep 1; done'

# ---- Window rules (first-match wins) ----

# Shell: tiled, no border, never floating, never fullscreen
for_window [app_id="apokolips-shell"] border none
for_window [app_id="apokolips-shell"] floating disable
for_window [app_id="apokolips-shell"] fullscreen disable

# Everything else floats by default
for_window [app_id=".*"] floating enable
for_window [title=".*"]  floating enable

# Explicit sizes for common apps
for_window [app_id="org.gnome.Terminal"] floating enable, resize set 1000 650, move position center
for_window [app_id="org.gnome.Nautilus"] floating enable, resize set 1000 700, move position center
for_window [app_id="apokolips-shell" title="Files"] floating enable, resize set 1000 700, move position center
for_window [title="Settings"] floating enable, resize set 780 540, move position center
for_window [title="Apokolips Settings"] floating enable, resize set 780 540, move position center
for_window [app_id="firefox"] floating enable, resize set 1200 800, move position center

# ---- Keybindings ----
bindsym $mod+Return exec foot
bindsym $mod+e exec /home/lytone/apokolips-shell/build/apokolips-shell --files
bindsym $mod+Shift+q kill
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
bindsym $mod+Shift+space floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exit
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3

# ---- Hide sway's default bar ----
bar {
    mode invisible
}
