        m_shuffleBtn->setChecked(
            VisualConfigManager::instance().cfg().boomtubeShuffle);
        refreshLoopButton();

        if (!initialPath.isEmpty()) open(initialPath);
        else {
            QString folder = VisualConfigManager::instance()
                                .cfg().boomtubeFolder;
            if (!folder.isEmpty() && QDir(folder).exists())
                openFolder(folder);
