                    "  border: none; border-radius: 7px;"
                    "  padding: 6px 18px; min-width: 80px;"
                    "}"
                    "QPushButton:hover { background: rgba(255,255,255,45); }");
                box.adjustSize();
                if (QWidget *top = window()) {
                    QPoint pt = top->mapToGlobal(QPoint(
