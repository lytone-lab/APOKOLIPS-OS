        cols[1]->addWidget(
            makeTile(QString::fromUtf8(apps[9].icon), apps[9].name, 9),
            0, Qt::AlignTop | Qt::AlignHCenter);

        pl->addLayout(gridRow);
        pl->addStretch();

        outer->addWidget(panel, 0, Qt::AlignHCenter);
        outer->addStretch();
