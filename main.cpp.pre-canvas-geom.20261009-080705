                    r->setStyleSheet(QString(
                        "color: %1; font-size: 12px; background: transparent;")
                        .arg(Sigil::textSecondary().name()));
                    h->addWidget(l);
                    h->addStretch();
                    h->addWidget(r);
                    cv->addLayout(h);
                };
