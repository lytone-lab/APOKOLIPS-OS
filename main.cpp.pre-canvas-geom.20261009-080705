        // ---- Allowed apps card ----
        {
            Sigil::Card *c = new Sigil::Card;
            QVBoxLayout *cv = new QVBoxLayout(c);
            cv->setContentsMargins(20, 18, 20, 18);
            cv->setSpacing(12);
