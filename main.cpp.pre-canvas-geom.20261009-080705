// ClipboardPanel — Win+V-style history popup
// =========================================================
class ClipboardPanel : public QWidget {
public:
    ClipboardPanel(QWidget *parent = nullptr) : QWidget(parent) {
        setAttribute(Qt::WA_NoSystemBackground, true);
        setFixedSize(340, 420);
        hide();

        QVBoxLayout *outer = new QVBoxLayout(this);
        outer->setContentsMargins(14, 14, 14, 14);
        outer->setSpacing(10);

        QLabel *title = new QLabel("Clipboard");
        title->setStyleSheet(
            "color: rgb(240, 237, 232);"
            "font-size: 15px; font-weight: 600;"
            "background: transparent;");
        outer->addWidget(title);

        m_search = new QLineEdit;
        m_search->setPlaceholderText("Search clipboard…");
        m_search->setFixedHeight(30);
        m_search->setStyleSheet(
            "QLineEdit {"
            "  background: rgba(255,255,255,20);"
            "  border: none;"
            "  border-radius: 8px;"
            "  color: rgb(240, 237, 232);"
            "  font-size: 12px;"
            "  padding: 0 10px;"
            "}"
            "QLineEdit:focus { background: rgba(255,255,255,35); }");
        QObject::connect(m_search, &QLineEdit::textChanged,
                         [this](const QString &s) {
            for (int i = 0; i < m_list->count(); ++i) {
                QListWidgetItem *it = m_list->item(i);
                bool hide = !s.isEmpty() &&
                    !it->text().contains(s, Qt::CaseInsensitive) &&
                    !it->data(Qt::UserRole).toString()
                        .contains(s, Qt::CaseInsensitive);
                it->setHidden(hide);
            }
        });
        outer->addWidget(m_search);

        m_list = new QListWidget;
        m_list->setFrameShape(QFrame::NoFrame);
        m_list->setStyleSheet(
            "QListWidget {"
            "  background: rgba(255,255,255,12);"
            "  border-radius: 10px;"
            "  color: rgb(240, 237, 232);"
            "  font-size: 12px;"
            "  padding: 4px;"
            "}"
            "QListWidget::item {"
            "  padding: 8px 10px;"
            "  border-radius: 6px;"
            "}"
            "QListWidget::item:hover { background: rgba(255,255,255,30); }"
            "QListWidget::item:selected {"
            "  background: rgba(168, 50, 50, 120);"
            "  color: #ffffff;"
            "}");
        outer->addWidget(m_list, 1);

        QObject::connect(m_list, &QListWidget::itemClicked,
                         [this](QListWidgetItem *it) {
            QString text = it->data(Qt::UserRole).toString();
            QProcess::startDetached("wl-copy", { text });
            hidePanel();
        });

        m_search->installEventFilter(this);

        // Poll the system clipboard for new entries
        m_poll = new QTimer(this);
        m_poll->setInterval(700);
        QObject::connect(m_poll, &QTimer::timeout,
                         this, &ClipboardPanel::pollClipboard);
        m_poll->start();
        pollClipboard();
    }

    void toggle() { isVisible() ? hidePanel() : showPanel(); }

    void showPanel() {
        QWidget *top = window();
        if (top) {
            QPoint c = top->mapToGlobal(QPoint(
                (top->width() - width()) / 2,
                (top->height() - height()) / 2));
            move(c);
        }
        raise();
        show();
        m_search->clear();
        m_search->setFocus();
    }

    void hidePanel() { hide(); }

protected:
    void paintEvent(QPaintEvent *) override {
        QPainter p(this);
        p.setRenderHint(QPainter::Antialiasing);
        QRect r = rect().adjusted(0, 0, -1, -1);

        // Soft shadow
        p.setPen(Qt::NoPen);
        for (int i = 14; i >= 1; --i) {
            QColor sh(0, 0, 0);
            sh.setAlphaF(0.012);
            p.setBrush(sh);
            p.drawRoundedRect(r.adjusted(-i, -i + 3, i, i + 3),
                              16 + i, 16 + i);
        }

        QPainterPath path;
        path.addRoundedRect(r, 16, 16);

        const auto &vc = VisualConfigManager::instance().cfg();
        const QPixmap &bg = ThemeManager::instance().blurredBg();
        if (!bg.isNull() && vc.blurStrength > 0.001 && window()) {
            p.save();
            p.setClipPath(path);
            QPoint pos = mapTo(window(), QPoint(0, 0));
            p.setOpacity(vc.blurStrength);
            p.drawPixmap(r, bg, QRect(pos, size()));
            p.restore();
        }

        p.fillPath(path, QColor(24, 22, 28, 235));
    }

    void keyPressEvent(QKeyEvent *e) override {
        if (e->key() == Qt::Key_Escape) {
            hidePanel(); e->accept(); return;
        }
        if (e->key() == Qt::Key_Down) {
            if (m_list->count() > 0) {
                m_list->setCurrentRow(0);
                m_list->setFocus();
            }
            e->accept(); return;
        }
        QWidget::keyPressEvent(e);
    }

    bool eventFilter(QObject *o, QEvent *ev) override {
        if (ev->type() == QEvent::KeyPress) {
            QKeyEvent *k = static_cast<QKeyEvent *>(ev);
            if (k->key() == Qt::Key_Return || k->key() == Qt::Key_Enter) {
                QListWidgetItem *it = m_list->currentItem();
                if (!it && m_list->count() > 0)
                    it = m_list->item(0);
                if (it) {
                    QProcess::startDetached("wl-copy",
                        { it->data(Qt::UserRole).toString() });
                    hidePanel();
                    return true;
                }
            }
            if (k->key() == Qt::Key_Escape) {
                hidePanel(); return true;
            }
        }
        if (o == m_search && ev->type() == QEvent::KeyPress) {
            QKeyEvent *k = static_cast<QKeyEvent *>(ev);
            if (k->key() == Qt::Key_Down) {
                m_list->setFocus();
                if (m_list->count() > 0) m_list->setCurrentRow(0);
                return true;
            }
        }
        return QWidget::eventFilter(o, ev);
    }

private:
    void pollClipboard() {
        QProcess p;
        p.start("wl-paste", { "-n" });
        p.waitForFinished(400);
        QString text = QString::fromUtf8(p.readAllStandardOutput());
        if (text.isEmpty() || text == m_last) return;
        m_last = text;

        // Skip if already in list
        for (int i = 0; i < m_list->count(); ++i) {
            if (m_list->item(i)->data(Qt::UserRole).toString() == text)
                return;
        }

        QString preview = text;
        preview.replace("\n", " ⏎ ");
        if (preview.length() > 100) preview = preview.left(97) + "…";

        QListWidgetItem *it = new QListWidgetItem(preview);
        it->setData(Qt::UserRole, text);
        it->setToolTip(text.left(500));
        m_list->insertItem(0, it);

        while (m_list->count() > 20)
            delete m_list->takeItem(m_list->count() - 1);
    }

    QListWidget *m_list = nullptr;
    QLineEdit   *m_search = nullptr;
    QTimer      *m_poll = nullptr;
    QString      m_last;
};

// =========================================================
// ApokolipsInputDialog — themed prompt (glass + traffic lights)
// =========================================================
class ApokolipsInputDialog : public QDialog {
public:
    static QString getText(QWidget *parent,
                           const QString &title,
                           const QString &label,
                           const QString &initialText,
                           bool *ok)
    {
        ApokolipsInputDialog dlg(title, label, initialText, parent);
        int r = dlg.exec();
        if (ok) *ok = (r == QDialog::Accepted);
        return (r == QDialog::Accepted) ? dlg.text() : QString();
    }

    ApokolipsInputDialog(const QString &title, const QString &label,
                         const QString &initialText, QWidget *parent)
        : QDialog(parent, Qt::Dialog | Qt::FramelessWindowHint)
    {
        setAttribute(Qt::WA_TranslucentBackground, true);
        setAttribute(Qt::WA_NoSystemBackground, true);
        resize(420, 180);

        if (parent) {
            QPoint c = parent->mapToGlobal(
                QPoint(parent->width()/2, parent->height()/2));
            move(c.x() - 210, c.y() - 90);
        } else if (QScreen *s = QApplication::primaryScreen()) {
            QRect g = s->availableGeometry();
            move(g.center().x() - 210, g.center().y() - 90);
        }

        // Build blurred backdrop from wallpaper
        Wallpaper *wp = WallpaperConfig::makeById(WallpaperConfig::loadId());
        if (wp) {
            const int DOWN = 8;
            QImage small(qMax(1, width()/DOWN), qMax(1, height()/DOWN),
                         QImage::Format_ARGB32_Premultiplied);
            small.fill(Qt::transparent);
            QPainter p(&small);
            p.setRenderHint(QPainter::Antialiasing);
            p.scale(1.0/DOWN, 1.0/DOWN);
            wp->paint(p, QRect(0, 0, width(), height()));
            p.end();
            m_blurredBg = QPixmap::fromImage(
                small.scaled(size(), Qt::IgnoreAspectRatio,
                             Qt::SmoothTransformation));
            delete wp;
        }

        buildUi(title, label, initialText);
        m_edit->setFocus();
        m_edit->selectAll();

        // Subscribe AFTER buildUi so restyle() has widgets to touch
        m_theme = ThemeManager::instance().current();
        restyle();

        ThemeManager::instance().subscribe([this](const Theme &t) {
            m_theme = t;
            restyle();
            update();
        });
        StyleManager::startPolling(this, [this]() { update(); });
    }

    QString text() const { return m_edit->text(); }

protected:
    void mousePressEvent(QMouseEvent *e) override {
        if (e->button() == Qt::LeftButton) {
            if (QWindow *wh = window()->windowHandle()) {
                if (wh->startSystemMove()) { e->accept(); return; }
            }
        }
        QWidget::mousePressEvent(e);
    }

    void keyPressEvent(QKeyEvent *e) override {
        if (e->key() == Qt::Key_Escape) {
            finish(QDialog::Rejected);
        } else if (e->key() == Qt::Key_Return ||
                   e->key() == Qt::Key_Enter) {
            finish(QDialog::Accepted);
        } else {
            QWidget::keyPressEvent(e);
        }
    }

    void paintEvent(QPaintEvent *) override {
        QPainter p(this);
        p.setRenderHint(QPainter::Antialiasing);

        QRect frameRect = rect().adjusted(0, 0, -1, -1);
        QPainterPath path;
        path.addRoundedRect(frameRect, 14, 14);

        // Soft edge shadow
        p.setPen(Qt::NoPen);
        for (int i = 5; i >= 1; --i) {
            QColor sh = m_theme.textPrimary;
            sh.setAlphaF(0.02 * (i / 5.0));
            p.setBrush(sh);
            p.drawRoundedRect(frameRect.adjusted(-i, -i + 2, i, i + 2),
                              14 + i, 14 + i);
        }

        // Blurred wallpaper backdrop
        if (!m_blurredBg.isNull()) {
            p.save();
            p.setClipPath(path);
            p.setOpacity(0.85);
            p.drawPixmap(rect(), m_blurredBg);
            p.restore();
        }

        // Style-aware body
        StyleRenderer::drawPanel(p, QRectF(frameRect), 14, m_theme, 200);

        // Header strip
        QPainterPath hdr;
        hdr.addRoundedRect(QRect(0, 0, width(), 36), 14, 14);
        QPainterPath sq;
        sq.addRect(QRect(0, 14, width(), 22));
