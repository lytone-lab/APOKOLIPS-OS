        m_loopBtn = new QPushButton(QString::fromUtf8("\xF0\x9F\x94\x81"));
        m_loopBtn->setFixedSize(28, 28);
        m_loopBtn->setCursor(Qt::PointingHandCursor);
        m_loopBtn->setStyleSheet(
